# Submission setup requires live FalkorDB. This URL is for local Docker only.
# For Cloud, replace it with the instance's connection URL before starting.
# Preview is an optional development simulator; it is not a qualifying submission.
RIPPLE_MODE=falkordb
FALKORDB_URL=redis://127.0.0.1:6379
FALKORDB_GRAPH=ripple_hackathon
# If your Cloud instance requires TLS, use rediss:// in the URL.
# Example: rediss://default:URL_ENCODED_PASSWORD@HOST:PORT
# Optional server-side model access; never put secrets in VITE_* variables.
# Provider: gemini, openai, offline. Blank selects Gemini if its key is present,
# otherwise OpenAI if its key is present, otherwise offline.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
PORT=3001
# Local defaults work without these. Set both explicitly for production.
BETTER_AUTH_URL=http://127.0.0.1:5173
BETTER_AUTH_SECRET=
