# preview is a development simulator, NOT a qualifying FalkorDB submission.
# Set to falkordb once the cloud connection is configured, then restart npm run dev.
RIPPLE_MODE=preview
FALKORDB_URL=
FALKORDB_GRAPH=ripple_hackathon
# If your Cloud instance requires TLS, use rediss:// in the URL.
# Example: rediss://default:URL_ENCODED_PASSWORD@HOST:PORT
# Optional server-side model access; never put secrets in VITE_* variables.
# Provider: gemini, openai, offline. Blank selects Gemini if its key is present,
# otherwise OpenAI if its key is present, otherwise offline.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
PORT=3001
