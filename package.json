{
  "name": "ripple-company-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check:db": "tsx scripts/check-db.ts",
    "check:model": "tsx scripts/check-model.ts",
    "check:research": "tsx scripts/check-company-research.ts",
    "check:companies": "tsx scripts/check-company-isolation.ts",
    "check:judge": "tsx scripts/check-judge-sandbox.ts",
    "check:live": "tsx scripts/check-company-isolation.ts --model",
    "check:reconnect": "tsx scripts/check-reconnect.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "better-auth": "^1.7.10",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "falkordb": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "openai": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
